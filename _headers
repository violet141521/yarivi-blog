# Cloudflare Pages — Cabeçalhos de segurança HTTP
# Documentação: https://developers.cloudflare.com/pages/configuration/headers/

/*
  # Impede que o navegador "adivinhe" o tipo MIME de respostas — previne ataques de sniffing
  X-Content-Type-Options: nosniff

  # Bloqueia o site de ser embutido em iframes (proteção contra clickjacking)
  X-Frame-Options: DENY

  # Controla quais informações de origem são enviadas com requisições — não vaza URL completa para externos
  Referrer-Policy: strict-origin-when-cross-origin

  # Desativa APIs do navegador que o blog não usa — reduz superfície de ataque
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=(), accelerometer=(), gyroscope=(), magnetometer=()

  # Content Security Policy — define quais origens podem carregar recursos
  # Notas:
  #   'unsafe-inline' em script-src: necessário pelo script de tema inline em cada página
  #   'unsafe-inline' em style-src: necessário pelos blocos <style> inline nos artigos
  #   Se no futuro mover o script de tema para arquivo externo, remover 'unsafe-inline' de script-src
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

# Diretórios internos — bloquear framing e indexação por bots secundários
/pesquisas/*
  X-Robots-Tag: noindex, nofollow

/signal-seo-writer/*
  X-Robots-Tag: noindex, nofollow

/signal-publicador/*
  X-Robots-Tag: noindex, nofollow

/signal-blog-publisher/*
  X-Robots-Tag: noindex, nofollow

/signal-seo-writer-workspace/*
  X-Robots-Tag: noindex, nofollow

/rascunhos/*
  X-Robots-Tag: noindex, nofollow

# ─── Cache ──────────────────────────────────────────────────────────────────
# s-maxage controla o edge da Cloudflare; max-age controla o browser.
# Artigos publicados não mudam após publicação → cache longo (4h).
# Partials mudam a cada artigo novo → cache curto (30 min).

# CSS e JS — raramente mudam
/style.css
  Cache-Control: public, max-age=86400, s-maxage=86400

/script.js
  Cache-Control: public, max-age=86400, s-maxage=86400

# Sitemap e robots
/sitemap.xml
  Cache-Control: public, max-age=86400, s-maxage=86400

/robots.txt
  Cache-Control: public, max-age=86400, s-maxage=86400

# Partials gerais (footer, nav, etc.) — cache 1h
/partials/*
  Cache-Control: public, max-age=3600, s-maxage=3600

# Partials da home que mudam a cada publicação — cache 30 min
# (regras mais específicas sobrepõem /partials/* acima)
/partials/featured.html
  Cache-Control: public, max-age=1800, s-maxage=1800

/partials/latest.html
  Cache-Control: public, max-age=1800, s-maxage=1800

# Artigos publicados — estáticos após publicação
/artigos/*
  Cache-Control: public, max-age=14400, s-maxage=14400

# Ícones e imagens estáticas — praticamente nunca mudam (achado do PageSpeed:
# ~4 KiB sem Cache-Control de longo prazo eram exatamente favicon.ico +
# favicon.svg + apple-touch-icon.png, carregados em toda página via <link
# rel="icon">/<link rel="apple-touch-icon"> no <head>). 30 dias de cache;
# se o ícone ou a imagem de capa mudar, renomeie o arquivo para invalidar o cache.
/favicon.ico
  Cache-Control: public, max-age=2592000, s-maxage=2592000

/favicon.svg
  Cache-Control: public, max-age=2592000, s-maxage=2592000

/apple-touch-icon.png
  Cache-Control: public, max-age=2592000, s-maxage=2592000

/og-cover.jpg
  Cache-Control: public, max-age=2592000, s-maxage=2592000

# Imagens de capa dos artigos — mesma lógica: estáticas após publicação
/img/*
  Cache-Control: public, max-age=2592000, s-maxage=2592000
